{%- comment -%}
  The password form below used to sit inside a pop-up that opened from an
  "Enter using password" link. That link was removed, but the theme CSS still
  hides the pop-up content until it is opened, so visitors never saw the form.
  These rules show the form directly on the page instead.
{%- endcomment -%}
{%- style -%}
  .password-header .password-modal,
  .password-header .password-modal__content {
    display: block !important;
    position: static !important;
    visibility: visible !important;
    opacity: 1 !important;
    transform: none !important;
    pointer-events: auto !important;
    width: 100%;
    max-width: 44rem;
    height: auto !important;
    margin: 2rem auto 0;
    background: transparent;
    box-shadow: none;
  }

  /* Keep the typed password readable no matter which color scheme the header uses. */
  .password-header .password-field .field__input {
    color: #121212 !important;
    -webkit-text-fill-color: #121212;
    caret-color: #121212;
    background-color: #ffffff !important;
  }
  .password-header .password-field .field__input::placeholder {
    color: rgba(18, 18, 18, 0.55) !important;
    -webkit-text-fill-color: rgba(18, 18, 18, 0.55);
  }
  .password-header .password-field .field__label {
    color: rgba(18, 18, 18, 0.65) !important;
  }
{%- endstyle -%}

<div class="header-wrapper color-{{ section.settings.color_scheme }} background">
  <div class="password-header">
    {% render 'header-logo', tag: 'h1' %}

    {%- if shop.password_message != blank -%}
      <div class="password-content">
        {{ shop.password_message }}
      </div>
    {%- endif -%}

    <div class="password-modal">
      <div class="password-modal__content">
        <h2 class="password-modal__content-heading" id="DialogHeading">
          {{ 'general.password_page.login_form_heading' | t }}
        </h2>
        {%- form 'storefront_password', class: 'password-form' -%}
          <div class="password-modal__wrapper">
            <div class="password-field field{% if form.errors %} password-field--error{% endif %}">
              <input
                type="password"
                name="password"
                id="Password"
                class="field__input"
                autocomplete="current-password"
                required
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="PasswordLoginForm-password-error"
                {%- endif -%}
                placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
              >
              <label class="field__label" for="Password">
                {{ 'general.password_page.login_form_password_placeholder' | t }}
              </label>
            </div>
            {%- if form.errors -%}
              <div id="PasswordLoginForm-password-error" role="status">
                <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                <span class="form__message">{{ 'general.password_page.login_form_error' | t }}</span>
              </div>
            {%- endif -%}
          </div>
          <button name="commit" class="password-button button button--primary button--primary-size focus-inset">
            {{ 'general.password_page.login_form_submit' | t }}
          </button>
        {%- endform -%}
        <small class="password__footer-text">{{ 'general.password_page.admin_link_html' | t }}</small>
      </div>
    </div>
  </div>
</div>
{%- if section.settings.color_scheme == 'background-1' -%}<hr>{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-password-header.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.header.settings.logo.label"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 350,
      "step": 5,
      "default": 90,
      "unit": "t:sections.header.settings.logo_width.unit",
      "label": "t:sections.header.settings.logo_width.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.main-password-header.settings.color_scheme.label"
    }
  ]
}
{% endschema %}
